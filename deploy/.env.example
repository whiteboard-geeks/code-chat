# Bootstrap creds for the Infisical machine identity that this container uses
# to fetch its real secrets at startup. Create these in the Infisical web UI:
# secrets.whiteboardgeeks.com → Org → Identities → Create Machine Identity (Universal Auth)
# Then add the identity to the "Whiteboard Geeks" project with Read access to
# /code-chat/ and /ANTHROPIC_API_KEY.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
